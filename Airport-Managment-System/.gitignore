# Ignore Visual Studio temporary files, build outputs, and other non-essential files

# Visual Studio files
.vs/
*.suo
*.user
*.user.*
*.sln.docstates
*.vssscc

# Build outputs
bin/
obj/
*.exe
*.dll
*.pdb
*.cache
*.ilk
*.exp

# Intermediate files
*.tmp
*.tmp*
*.log
*.cache
*.VC.db
*.VC.opendb
*.sdf
*.suo
*.idb
*.sbr

# NuGet packages
packages/

# Test results
TestResults/
*.trx

# ReSharper files (if you use ReSharper)
.ReSharper*

# Rider files (if you use Rider)
.idea/

# Other IDE files (if applicable)
.DS_Store  # macOS Finder store
Thumbs.db   # Windows thumbnail cache

# Backup files
*.bak
*.backup

# Temporary files
*.tmp
*.temp

# Git related
.gitattributes
.gitignore

# Deployment related (if applicable)
*.zip
*.rar
*.7z

# Project-specific ignores (add your own here)
# Example:
# Data/SensitiveData.csv  # Ignore sensitive data files
# MyCustomLogFiles/       # Ignore log files directory

# Files generated by Visual Studio or other tools that should not be tracked
*.assembly.cache
*.csproj.user
*.csx
*.designer.cs
*.orig
*.rar~
*.refresh
*.sh
*.suo
*.tags
*.user
*.userprefs
*.visualelements
*.vsidx
*.vspscc
*.vstemplate
*.vsx
*.vtx
*.wrn
*.xap
*.xaml.metagen
*.yproj
*.zip~
*.DS_Store

# Folders generated by Visual Studio or other tools that should not be tracked
_ReSharper.TestRunner/
_ReSharper.UnitTestRunner/
_Resharper.UnitTestSession/
_UpgradeReport/
Backup/
ClientBin/
Content/
CustomControls/
Data/
Docs/
External/
Logs/
MyProject.Tests/
obj/
Old_App_Code/
packages/
Reports/
Resources/
